generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum MfaChallengePurpose {
  LOGIN
  SETUP
}

enum MfaAuthenticationMethod {
  TOTP
  RECOVERY_CODE
}

enum AuditFieldChangeType {
  CREATE
  UPDATE
  DELETE
}

enum AuditValueStorageMode {
  PLAIN
  ENCRYPTED
  NONE
}

model User {
  id                     String      @id @default(cuid())
  loginName              String      @unique
  contactEmail           String?
  contactEmailVerifiedAt DateTime?
  passwordHash           String
  firstName              String
  lastName               String?
  role                   UserRole    @default(USER)
  permissions            Json?
  /// Which games and teams the account reaches in the Esport pole (owner,
  /// 10 November 2026), always `ALL` for an administrator
  /// (`User_esportScope_admin_check`).
  esportScope            EsportScope @default(ALL)
  isActive               Boolean     @default(true)
  /// Singleton application root. Database constraints require this account
  /// to remain active, undeleted and administrative.
  isProtected            Boolean     @default(false)
  mustChangePassword     Boolean     @default(false)
  lastLoginAt            DateTime?
  passwordChangedAt      DateTime?
  mfaEnabledAt           DateTime?
  securityVersion        Int         @default(0)
  /// Irreversible deletion marker. Deleted rows are anonymous, immutable
  /// technical tombstones retained only for audit and identifier ownership.
  deletedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  sessions              Session[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  targetedAuditLogs     AuditLog[]             @relation("AuditTarget")
  loginNameReservations LoginNameReservation[]
  totpCredential        TotpCredential?
  totpEnrollment        TotpEnrollment?
  mfaRecoveryCodes      MfaRecoveryCode[]
  mfaLoginChallenge     MfaLoginChallenge?
  updatedSystemSettings SystemSetting[]        @relation("SystemSettingUpdater")
  esportScopeItems      UserEsportScopeItem[]
  // Search: trigram indexes on public.search_text(identity) and
  // public.search_text(contactEmail), expression indexes kept in the
  // 20261031140000_shared_search_text migration.

  @@index([contactEmail])
  @@index([role])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, isActive])
  @@index([deletedAt, lastLoginAt])
  @@index([deletedAt, mustChangePassword])
  @@index([deletedAt, role])
  @@index([mfaEnabledAt])
}

/// Which games and teams an account reaches in the Esport pole (owner,
/// 10 November 2026: « c'est l'utilisateur et ses autorisations qui font, pas
/// un rôle dans une équipe »). Set in its authorizations; a function held in a
/// roster never opens anything.
enum EsportScope {
  /// Every game and every team, as before the scope existed.
  ALL
  /// The chosen games, with all their teams, future ones included.
  GAMES
  /// The chosen teams only.
  TEAMS
}

/// A game or a team chosen in an account's Esport scope, exactly one of the
/// two (`UserEsportScopeItem_target_check`). Only the rows of the scope's kind
/// count; an empty list opens nothing. A game or team deleted leaves it.
model UserEsportScopeItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@unique([userId, teamId])
  @@index([gameId])
  @@index([teamId])
}

/// Permanent ownership history for authentication identifiers. A login name
/// remains attached to its original user even when that user changes names or
/// is irreversibly deleted, so it can never be reassigned to another identity.
model LoginNameReservation {
  loginName String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Session {
  id                        String                  @id @default(cuid())
  userId                    String
  securityVersion           Int                     @default(0)
  token                     String                  @unique
  expiresAt                 DateTime
  idleExpiresAt             DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP + '00:30:00'::interval)"))
  lastSeenAt                DateTime                @default(now())
  rememberMe                Boolean                 @default(false)
  passwordReauthenticatedAt DateTime?
  criticalMfaVerifiedAt     DateTime?
  mfaVerifiedAt             DateTime
  mfaMethod                 MfaAuthenticationMethod
  userAgent                 String?
  ipAddress                 String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, expiresAt])
  @@index([userId, idleExpiresAt])
  @@index([userId, createdAt])
}

/// Encrypted active TOTP seed. Secrets never live on the User row so ordinary
/// user reads cannot accidentally expose authentication material.
model TotpCredential {
  userId           String    @id
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  secretKeyVersion Int       @default(1)
  lastUsedTimeStep BigInt?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastUsedAt])
}

/// Short-lived replacement seed. Keeping enrollment separate means an active
/// authenticator continues working until the new one is successfully proven.
model TotpEnrollment {
  userId           String   @id
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  secretKeyVersion Int      @default(1)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Recovery codes are high-entropy, single-use values. Only salted hashes are
/// stored; plaintext codes are returned once when generated.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  salt      String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

/// Password-first login state. The browser receives only a random HttpOnly
/// token whose hash is stored here; no application session exists yet.
model MfaLoginChallenge {
  id                  String              @id @default(cuid())
  userId              String              @unique
  tokenHash           String              @unique
  purpose             MfaChallengePurpose
  securityVersion     Int
  credentialUpdatedAt DateTime?
  rememberMe          Boolean             @default(false)
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([purpose, expiresAt])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ATTEMPTS_BLOCKED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ACCOUNT_LOCKED
  SESSION_INVALIDATE
  MFA_ENABLED
  MFA_DISABLED
  MFA_RECOVERY_CODE_USED
  MFA_RECOVERY_CODES_REGENERATED
  MFA_RESET
  STEP_UP_SUCCESS
  STEP_UP_FAILED
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  PERMISSION_UPDATE
  AUDIT_EXPORT
  AUDIT_VIEW
  AUDIT_PURGE
  NOTIFICATION_SEND
  INTERNAL_ANNOUNCEMENT_PUBLISH
  INTERNAL_ANNOUNCEMENT_PIN_UPDATE
  SYSTEM_SETTING_UPDATE
  BACKGROUND_JOB_UPDATE
  PERSON_CREATE
  PERSON_UPDATE
  PERSON_DELETE
  GAME_CREATE
  GAME_UPDATE
  GAME_DELETE
  GAME_REORDER
  TEAM_CREATE
  TEAM_UPDATE
  TEAM_DELETE
  TEAM_REORDER
  FUNCTION_CREATE
  FUNCTION_UPDATE
  FUNCTION_DELETE
  FUNCTION_REORDER
  PASSAGE_CREATE
  PASSAGE_UPDATE
  PASSAGE_DELETE
  LEGAL_ENTITY_CREATE
  LEGAL_ENTITY_UPDATE
  LEGAL_ENTITY_DELETE
  FINANCIAL_ACCOUNT_CREATE
  FINANCIAL_ACCOUNT_UPDATE
  FINANCIAL_ACCOUNT_DELETE
  ORGANIZATION_CREATE
  ORGANIZATION_UPDATE
  ORGANIZATION_DELETE
  ORGANIZATION_CONTACT_CREATE
  ORGANIZATION_CONTACT_UPDATE
  ORGANIZATION_CONTACT_DELETE
  FINANCIAL_OPERATION_CREATE
  FINANCIAL_OPERATION_UPDATE
  FINANCIAL_OPERATION_DELETE
  TREASURY_CHOICE_CREATE
  TREASURY_CHOICE_UPDATE
  TREASURY_CHOICE_DELETE
  TREASURY_CHOICE_REORDER
  /// Historical only. The partner module was removed from the application on
  /// 2026-09-21; these values stay declared so older journal entries remain
  /// readable. No code produces them anymore.
  PARTNER_CREATE
  PARTNER_UPDATE
  PARTNER_STATUS_UPDATE
  PARTNER_PERIOD_CREATE
  PARTNER_PERIOD_UPDATE
  PARTNER_CONTACTS_UPDATE
  PARTNER_FOLLOW_UP_CREATE
  PARTNER_FOLLOW_UP_UPDATE
  PARTNER_FOLLOW_UP_DELETE
  PARTNER_FOLLOW_UP_COMPLETE
  PARTNER_MERGE
  PARTNER_DELETE
}

enum AuditCategory {
  AUTH
  USER
  PERMISSION
  SYSTEM
  PERSON
  GAME
  TEAM
  FUNCTION
  PASSAGE
  LEGAL_ENTITY
  FINANCIAL_ACCOUNT
  ORGANIZATION
  FINANCIAL_OPERATION
  TREASURY_CHOICE
  /// Historical only, kept for the same reason as `AuditAction.PARTNER_*`.
  PARTNER
}

enum AuditEventKind {
  ACTIVITY
  CONNECTION
}

enum AuditStream {
  AUTHENTICATION
  SECURITY
  IDENTITY
  AUTHORIZATION
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  NEUTRAL
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id                        String         @id @default(cuid())
  userId                    String?
  user                      User?          @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict)
  actorDisplayNameSnapshot  String?
  actorLoginNameSnapshot    String?
  actorRoleSnapshot         UserRole?
  targetUserId              String?
  targetUser                User?          @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetDisplayNameSnapshot String?
  targetLoginNameSnapshot   String?
  targetRoleSnapshot        UserRole?
  action                    AuditAction
  category                  AuditCategory
  eventKind                 AuditEventKind @default(ACTIVITY)
  stream                    AuditStream    @default(SYSTEM)
  outcome                   AuditOutcome   @default(SUCCESS)
  severity                  AuditSeverity  @default(INFO)
  eventVersion              Int            @default(1)
  description               String
  metadata                  Json?
  poleKey                   String?
  pageKey                   String?
  tabKey                    String?
  entityType                String?        @db.VarChar(40)
  entityId                  String?        @db.VarChar(128)
  requestId                 String?
  ipAddress                 String?
  userAgent                 String?
  /// The four names above in the shared search form, written by the
  /// AuditLog_search_text trigger: never set by the application.
  searchText                String?
  createdAt                 DateTime       @default(now())

  fieldChanges AuditFieldChange[]

  @@unique([id, entityType, entityId])
  @@index([userId, action])
  @@index([userId, createdAt, id])
  @@index([targetUserId, action])
  @@index([targetUserId, createdAt, id])
  @@index([poleKey, createdAt, id])
  @@index([poleKey, pageKey, createdAt, id])
  @@index([pageKey, createdAt, id])
  @@index([eventKind, createdAt, id])
  @@index([stream, createdAt, id])
  @@index([outcome, createdAt, id])
  @@index([severity, createdAt, id])
  @@index([requestId])
  @@index([action, createdAt, id])
  @@index([category, createdAt, id])
  @@index([entityType, entityId, createdAt, id])
  @@index([createdAt, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "AuditLog_searchText_trgm_idx")
}

model AuditEncryptionKeyVersion {
  version     Int      @id
  algorithm   String   @default("AES-256-GCM") @db.VarChar(32)
  firstUsedAt DateTime @default(now())

  fieldChanges AuditFieldChange[]
}

model AuditFieldChange {
  id               String                @id @default(cuid())
  auditLogId       String
  entityType       String                @db.VarChar(40)
  entityId         String                @db.VarChar(128)
  sectionKey       String                @db.VarChar(64)
  fieldKey         String                @db.VarChar(100)
  recordId         String?               @db.VarChar(128)
  changeType       AuditFieldChangeType
  valueMode        AuditValueStorageMode
  beforeValue      String?               @db.VarChar(512)
  afterValue       String?               @db.VarChar(512)
  valuesCiphertext Bytes?
  valuesIv         Bytes?
  valuesAuthTag    Bytes?
  valueKeyVersion  Int?
  beforeHash       String?               @db.Char(64)
  afterHash        String?               @db.Char(64)
  createdAt        DateTime

  auditLog             AuditLog                   @relation(fields: [auditLogId, entityType, entityId], references: [id, entityType, entityId], onDelete: Cascade)
  encryptionKeyVersion AuditEncryptionKeyVersion? @relation(fields: [valueKeyVersion], references: [version], onDelete: Restrict)

  @@index([auditLogId])
  @@index([entityType, entityId, sectionKey, fieldKey, recordId, createdAt, id], map: "AuditFieldChange_history_lookup_idx")
  @@index([valueKeyVersion])
}

/// Durable identity, independent from a login account. Whether a person is in
/// the structure is computed from its passages, never stored (9 November 2026).
/// SQL migrations additionally enforce identity pairs and positive versions.
model Person {
  id                  String    @id @default(cuid())
  nickname            String?   @db.VarChar(80)
  normalizedNickname  String?   @db.VarChar(160)
  firstName           String?   @db.VarChar(100)
  normalizedFirstName String?   @db.VarChar(200)
  lastName            String?   @db.VarChar(100)
  normalizedLastName  String?   @db.VarChar(200)
  sortName            String    @db.VarChar(401)
  birthDate           DateTime? @db.Date
  /// ISO 3166-1 alpha-2 code in capitals, « FR » (10 November 2026).
  nationality         String?   @db.VarChar(2)
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  emails               PersonEmail[]
  phones               PersonPhone[]
  socialProfiles       PersonSocialProfile[]
  otherNicknames       PersonOtherNickname[]
  emergencyContacts    PersonEmergencyContact[]
  legalGuardians       PersonLegalGuardian[]    @relation("GuardedPerson")
  guardianOf           PersonLegalGuardian[]    @relation("Guardian")
  passages             PersonPassage[]
  organizationContacts OrganizationContact[]
  financialOperations  FinancialOperation[]

  @@index([createdAt, id])
  @@index([updatedAt, id])
  @@index([sortName, id])
  @@index([normalizedNickname(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_normalizedNickname_trgm_idx")
  @@index([normalizedFirstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_normalizedFirstName_trgm_idx")
  @@index([normalizedLastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_normalizedLastName_trgm_idx")
  @@index([normalizedNickname(ops: raw("varchar_pattern_ops"))], map: "Person_normalizedNickname_prefix_idx")
  @@index([normalizedFirstName(ops: raw("varchar_pattern_ops"))], map: "Person_normalizedFirstName_prefix_idx")
  @@index([normalizedLastName(ops: raw("varchar_pattern_ops"))], map: "Person_normalizedLastName_prefix_idx")
}

/// Owned contact. SQL adds one-primary-per-person and immutable ownership rules.
model PersonEmail {
  id              String   @id @default(cuid())
  personId        String
  email           String   @db.VarChar(320)
  normalizedEmail String   @db.VarChar(320)
  label           String   @db.VarChar(40)
  isPrimary       Boolean  @default(false)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, normalizedEmail])
  @@index([normalizedEmail])
  @@index([normalizedEmail(ops: raw("varchar_pattern_ops"))], map: "PersonEmail_normalizedEmail_prefix_idx")
}

/// Owned contact. SQL adds one-primary-per-person and immutable ownership rules.
model PersonPhone {
  id              String   @id @default(cuid())
  personId        String
  phone           String   @db.VarChar(40)
  normalizedPhone String   @db.VarChar(16)
  label           String   @db.VarChar(40)
  isPrimary       Boolean  @default(false)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, normalizedPhone])
  @@index([normalizedPhone])
  @@index([normalizedPhone(ops: raw("varchar_pattern_ops"))], map: "PersonPhone_normalizedPhone_prefix_idx")
}

/// Owned profile, unique within a person/network. SQL also enforces a usable
/// identifier or URL and at most one primary profile per person/network.
model PersonSocialProfile {
  id                       String   @id @default(cuid())
  personId                 String
  networkKey               String   @db.VarChar(40)
  identifier               String?  @db.VarChar(100)
  normalizedIdentifier     String?  @db.VarChar(100)
  profileUrl               String?  @db.VarChar(2048)
  normalizedProfileUrl     String?  @db.VarChar(2048)
  normalizedProfileUrlHash String?  @db.Char(64)
  label                    String   @db.VarChar(40)
  isPrimary                Boolean  @default(false)
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, networkKey, normalizedIdentifier], map: "PersonSocialProfile_person_network_identifier_key")
  @@unique([personId, networkKey, normalizedProfileUrlHash], map: "PersonSocialProfile_person_network_url_hash_key")
  @@index([normalizedIdentifier])
  @@index([normalizedIdentifier(ops: raw("varchar_pattern_ops"))], map: "PersonSocialProfile_normalizedIdentifier_prefix_idx")
  @@index([normalizedProfileUrlHash])
}

/// Another pseudo of a person (10 November 2026, « ok go »): a former one, a
/// second account, a name in a game, a nickname. The Répertoire's search finds
/// a record by it, to recognize someone who changed names. Read and written
/// with the identity.
model PersonOtherNickname {
  id                 String         @id @default(cuid())
  personId           String
  nickname           String         @db.VarChar(80)
  /// Shared search form, unique within the record.
  normalizedNickname String         @db.VarChar(160)
  /// « Ancien pseudo », « Compte secondaire »… as typed, optional.
  note               String?        @db.VarChar(40)
  /// Used until then, optional: stored on the last day of its period.
  untilOn            DateTime?      @db.Date
  untilPrecision     DatePrecision?
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, normalizedNickname])
  @@index([normalizedNickname(ops: raw("gin_trgm_ops"))], type: Gin, map: "PersonOtherNickname_normalizedNickname_trgm_idx")
  @@index([normalizedNickname(ops: raw("varchar_pattern_ops"))], map: "PersonOtherNickname_normalizedNickname_prefix_idx")
}

/// Who to call for a person in an emergency (10 November 2026): a name, the
/// link with the person and a number, not a record of the Répertoire. SQL
/// keeps it on its person, like the other coordinates.
model PersonEmergencyContact {
  id              String   @id @default(cuid())
  personId        String
  name            String   @db.VarChar(100)
  /// « Mère », « Conjoint »… as typed, optional.
  relation        String?  @db.VarChar(40)
  phone           String   @db.VarChar(40)
  normalizedPhone String   @db.VarChar(16)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

/// How a legal representative stands to the person: a fixed list of the code.
enum LegalGuardianRelation {
  PARENT
  TUTOR
  OTHER
}

/// A legal representative of a person, minor in general (10 November 2026):
/// another record of the Répertoire, linked explicitly, with its own
/// coordinates. The link goes with the represented person; the
/// representative's record cannot be deleted while it represents someone
/// (`ON DELETE RESTRICT`). SQL refuses a person as their own representative
/// and keeps both ends of a link fixed: a new representative is a new link.
model PersonLegalGuardian {
  id         String                @id @default(cuid())
  personId   String
  person     Person                @relation("GuardedPerson", fields: [personId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Person                @relation("Guardian", fields: [guardianId], references: [id], onDelete: Restrict)
  relation   LegalGuardianRelation @default(PARENT)
  version    Int                   @default(1)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([personId, guardianId])
  @@index([guardianId])
}

model PersonDeletionTombstone {
  personId            String   @id @db.VarChar(128)
  deletionOperationId String   @unique @db.VarChar(191)
  deletedAt           DateTime @default(now())
}

model RateLimit {
  id           String    @id @default(cuid())
  key          String    @unique
  count        Int       @default(0)
  firstAttempt DateTime  @default(now())
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
}

/// Non-secret runtime configuration. Credentials and encryption material must
/// remain in the deployment secret manager and never be stored in this table.
/// How precisely an approximate date is known: a date known to the year is
/// stored on 1 January, to the month on its first day, never with an invented
/// day (registre historique, 7 November 2026).
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

/// A game of the structure, one section per game: the first page of the
/// Esport pole (8 November 2026). Its teams sit under it, its functions in
/// its record (9 November 2026).
model Game {
  id                   String                @id @default(cuid())
  name                 String                @db.VarChar(60)
  /// Shared search form of the name: « Valorant » and « VALORANT » are one game.
  normalizedName       String                @unique @db.VarChar(120)
  shortName            String?               @db.VarChar(12)
  firstOpenedOn        DateTime              @db.Date
  firstOpenedPrecision DatePrecision         @default(DAY)
  /// Rank of the game, set by dragging, active or not (9 November 2026).
  position             Int                   @default(0)
  isActive             Boolean               @default(true)
  version              Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  teams                Team[]
  functions            MemberFunction[]
  financialOperations  FinancialOperation[]
  esportScopeItems     UserEsportScopeItem[]

  @@index([isActive, position])
}

/// A team of a game, shown under it on the Jeux page (8 November 2026). Its
/// game cannot be deleted while it exists (`ON DELETE RESTRICT`); the roster
/// comes next.
model Team {
  id               String        @id @default(cuid())
  gameId           String
  game             Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  name             String        @db.VarChar(60)
  /// Shared search form of the name, unique within the game only: each game
  /// may have its own « Noctambule ».
  normalizedName   String        @db.VarChar(120)
  foundedOn        DateTime      @db.Date
  foundedPrecision DatePrecision @default(DAY)
  /// Rank of the team in its game, set by dragging, active or not.
  position         Int           @default(0)
  isActive         Boolean       @default(true)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  passages            PersonPassage[]
  esportScopeItems    UserEsportScopeItem[]
  financialOperations FinancialOperation[]

  @@unique([gameId, normalizedName])
  @@index([gameId, isActive, position])
}

/// What a function is about (9 November 2026), a fixed list in the code: in a
/// game, playing or supervising the players (coach, manager, analyst); in the
/// structure, the board (elected mandates) or its staff (graphiste, monteur,
/// bénévole). `MemberFunction_kind_scope_check` keeps the board out of the
/// games and the players out of the structure.
enum MemberFunctionKind {
  BOARD
  PLAYER
  STAFF
}

/// A function held in a team of a game (Joueur, Coach…), managed in the game's
/// record (9 November 2026), or in the structure itself (`gameId` empty:
/// Président, Graphiste…), managed in Bureau & staff, unique among themselves
/// (partial index in the migration). Renaming corrects a typo; a function that
/// changes becomes a new one and the old one turns inactive, still chosen for
/// old passages. Within its game or the structure, each kind keeps the order
/// its managers set by dragging (`position`, 9 November 2026), the same on
/// every page.
model MemberFunction {
  id             String             @id @default(cuid())
  gameId         String?
  game           Game?              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  name           String             @db.VarChar(40)
  /// Shared search form of the name: « Coach » and « COACH » are one function.
  normalizedName String             @db.VarChar(80)
  kind           MemberFunctionKind
  /// Rank within the game and the kind, from 0; ties fall back on the name.
  position       Int                @default(0)
  isActive       Boolean            @default(true)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  passages PersonPassage[]

  @@unique([gameId, normalizedName])
  @@index([gameId, kind, position])
}

/// A passage (9 November 2026, registre historique): a person of the
/// Répertoire in a team, or in the structure (`teamId` empty, Bureau & staff), with a
/// function, from a start to an end (none: still there). A start is stored on
/// the first day of its period, an end on the last: « who was there on a
/// date » stays a plain comparison. The base checks the function belongs to
/// the team's game, and that two identical passages never overlap (exclusion
/// constraint and trigger in the migration, absent from this schema).
model PersonPassage {
  id             String         @id @default(cuid())
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  functionId     String
  memberFunction MemberFunction @relation(fields: [functionId], references: [id], onDelete: Restrict)
  startOn        DateTime       @db.Date
  startPrecision DatePrecision  @default(DAY)
  endOn          DateTime?      @db.Date
  endPrecision   DatePrecision?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([teamId])
  @@index([personId])
  @@index([functionId])
}

/// The form an entity has in law (10 November 2026). NONE is the period before
/// the association: no identifier, no account, never principal.
enum LegalForm {
  NONE
  ASSOCIATION
  SAS
  SASU
  SARL
  EURL
  OTHER
}

/// An entity that carries the structure's acts: the association, maybe a
/// company tomorrow, and the period before them (cadrage des entités). Checks
/// on form, identifiers and dates, the single principal entity and the form
/// kept while it holds accounts live in the migration only.
model LegalEntity {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(120)
  normalizedName String             @unique @db.VarChar(240)
  form           LegalForm
  /// Name of the form when it is OTHER, and only then.
  otherForm      String?            @db.VarChar(60)
  startOn        DateTime           @db.Date
  startPrecision DatePrecision      @default(DAY)
  endOn          DateTime?          @db.Date
  endPrecision   DatePrecision?
  rnaNumber      String?            @db.VarChar(10)
  siretNumber    String?            @db.VarChar(14)
  headOffice     String?            @db.VarChar(300)
  /// Proposed when nothing else gives an act's entity; one at most.
  isPrincipal    Boolean            @default(false)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  accounts       FinancialAccount[]

  @@index([startOn])
}

enum FinancialAccountKind {
  BANK
  ONLINE
  CASH
}

/// A bank account, an online account or a cash box of an entity (10 November
/// 2026). Its entity is fixed at creation and has a legal form (trigger
/// `FinancialAccount_entity_check`, absent from this schema); amounts are in
/// euro cents.
model FinancialAccount {
  id                  String               @id @default(cuid())
  entityId            String
  entity              LegalEntity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  name                String               @db.VarChar(80)
  normalizedName      String               @db.VarChar(160)
  kind                FinancialAccountKind
  /// Bank or service holding it; none for a cash box.
  institution         String?              @db.VarChar(80)
  /// The site's figures start here: the balance on that day.
  openingOn           DateTime             @db.Date
  openingBalanceCents Int
  closedOn            DateTime?            @db.Date
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  operations          FinancialOperation[] @relation("OperationAccount")
  incomingTransfers   FinancialOperation[] @relation("OperationToAccount")

  @@unique([entityId, normalizedName])
}

enum TreasuryChoiceKind {
  INCOME_CATEGORY
  EXPENSE_CATEGORY
  PAYMENT_METHOD
}

/// A value of a list of the treasury, kept on the site (11 November 2026): a
/// category of money received or paid, or a payment method; ranked by hand
/// within its kind, inactive values still choosable. Its kind stays once an
/// operation uses it (trigger `TreasuryChoice_kind_check`, absent here).
model TreasuryChoice {
  id                 String               @id @default(cuid())
  kind               TreasuryChoiceKind
  name               String               @db.VarChar(60)
  normalizedName     String               @db.VarChar(120)
  position           Int                  @default(0)
  isActive           Boolean              @default(true)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  categoryOperations FinancialOperation[] @relation("OperationCategory")
  paymentOperations  FinancialOperation[] @relation("OperationPaymentMethod")

  @@unique([kind, normalizedName])
  @@index([kind, position])
}

enum FinancialOperationKind {
  INCOME
  EXPENSE
  TRANSFER
}

/// Money received, paid, or moved between two accounts of one entity (11
/// November 2026). The amount is positive, in euro cents: the kind gives the
/// sign. A transfer has no label, category, payer nor team; the others have a
/// label and a category of their kind. Its accounts' periods cover its day
/// (trigger `FinancialOperation_check` and the checks of the migration,
/// absent here).
model FinancialOperation {
  id              String                 @id @default(cuid())
  kind            FinancialOperationKind
  occurredOn      DateTime               @db.Date
  amountCents     Int
  accountId       String
  account         FinancialAccount       @relation("OperationAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccountId     String?
  toAccount       FinancialAccount?      @relation("OperationToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  label           String?                @db.VarChar(120)
  categoryId      String?
  category        TreasuryChoice?        @relation("OperationCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethodId String?
  paymentMethod   TreasuryChoice?        @relation("OperationPaymentMethod", fields: [paymentMethodId], references: [id], onDelete: Restrict)
  organizationId  String?
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  personId        String?
  person          Person?                @relation(fields: [personId], references: [id], onDelete: Restrict)
  teamId          String?
  team            Team?                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  gameId          String?
  game            Game?                  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  note            String?                @db.VarChar(500)
  /// Label and note normalised for the site's search.
  searchText      String                 @default("") @db.VarChar(700)
  version         Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([occurredOn(sort: Desc), createdAt(sort: Desc)])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([organizationId])
  @@index([personId])
  @@index([teamId])
  @@index([gameId])
}

/// What an organisation is to the structure (11 November 2026); several at
/// once (`Organization_kinds_check`, absent from this schema).
enum OrganizationKind {
  SPONSOR
  PARTNER
  SUPPLIER
  CLIENT
  ORGANIZER
  FUNDER
}

/// An organisation the structure deals with (11 November 2026): one record
/// whatever it is to the structure, its kinds listed together.
model Organization {
  id             String                @id @default(cuid())
  name           String                @db.VarChar(120)
  normalizedName String                @unique @db.VarChar(240)
  kinds          OrganizationKind[]
  website        String?               @db.VarChar(200)
  siretNumber    String?               @db.VarChar(14)
  address        String?               @db.VarChar(300)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  contacts       OrganizationContact[]
  operations     FinancialOperation[]
}

/// A person to reach at an organisation. Linked to a record of the Répertoire
/// only when the person has one (one link per organisation, partial unique
/// index absent from this schema); the name is then the record's.
model OrganizationContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String?
  person         Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  name           String       @db.VarChar(100)
  role           String?      @db.VarChar(80)
  /// Lower case.
  email          String?      @db.VarChar(254)
  /// International form, « +33612345678 ».
  phone          String?      @db.VarChar(16)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([personId])
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([updatedById])
}
